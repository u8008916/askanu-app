# Copy to `.env` (git-ignored) and adjust locally.
# Only VITE_-prefixed values reach browser code, so never put a secret in one.

# Browser/API boundary.
# Leave empty in local frontend development so requests stay same-origin and
# `/api/*` is forwarded by the Vite dev proxy.
VITE_API_BASE_URL=

ASKANU_ENV=local

# Canonical service ports:
# - React dev server: 5173
# - App boundary: 8080
# - RAG service: 8081
RAG_SERVICE_URL=http://localhost:8081

# --- Development only -------------------------------------------------------

# Where the Vite dev proxy forwards `/api` while the App boundary is not yet
# running locally. For Day 3 local integration this points directly to RAG.
VITE_DEV_PROXY_TARGET=http://localhost:8081

# `1` selects the mock transport instead of the real /api/v1/ask client.
# Dev builds only; a production build drops the mock entirely.
# VITE_USE_MOCK_TRANSPORT=1
