# Copy to `.env` (git-ignored) and adjust locally. Only VITE_-prefixed values
# reach browser code, so never put a secret in one.

# The App integration boundary the browser posts to. Leave EMPTY to use the
# same origin (`/api/v1/ask`), which routes through the Vite dev proxy locally.
VITE_API_BASE_URL=http://localhost:8080
ASKANU_ENV=local
RAG_SERVICE_URL=http://localhost:8081

# --- Development only -------------------------------------------------------
# Where the Vite dev proxy forwards `/api`. Used only when VITE_API_BASE_URL is
# empty. Set this if port 8080 is taken on your machine.
# VITE_DEV_PROXY_TARGET=http://localhost:8080

# `1` selects the mock transport instead of the real /api/v1/ask client, so the
# response states can be exercised with no backend running. Dev builds only; a
# production build drops the mock entirely.
# VITE_USE_MOCK_TRANSPORT=1
