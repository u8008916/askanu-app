# Copy to `.env` (git-ignored) and adjust locally.
# Only VITE_-prefixed values reach browser code, so never put a secret in one.

# --- Browser ----------------------------------------------------------------

# The App integration boundary the browser posts to.
# Leave empty in local frontend development so requests stay same-origin and
# `/api/*` is forwarded by the Vite dev proxy.
#
# Leave it empty in production too. Firebase Hosting rewrites `/api/**` to the
# App Cloud Run service (see firebase.json), so the deployed browser also posts
# a relative `/api/v1/ask` and CORS never applies. See docs/DEPLOYMENT.md.
VITE_API_BASE_URL=

ASKANU_ENV=local

# --- App service (server/) --------------------------------------------------
# Server-side only. These are read by the Node process, never by browser code:
# they have no VITE_ prefix, so Vite cannot place them in the bundle. Do not add
# one to make a value "easier to reach" from React.

# Canonical service ports:
# - React dev server: 5173
# - App boundary: 8080
# - RAG service: 8081
PORT=8080

# Where the App service forwards `/api/v1/ask`. The process refuses to start
# without it. In GCP this is the deployed RAG service URL, not localhost.
RAG_SERVICE_URL=http://localhost:8081

# The deployed RAG service is private: every call carries an identity token for
# the App's runtime service account, obtained from the Cloud Run metadata server
# with RAG_SERVICE_URL as the audience. That is ON by default so a deploy that
# sets nothing is still authenticated.
#
# Local only. A local RAG is unauthenticated and there is no metadata server, so
# leaving this unset makes every /ask a 502. Never set it in a Cloud Run deploy.
RAG_AUTH_DISABLED=true

# --- Development only -------------------------------------------------------

# Where the Vite dev proxy forwards `/api` while the App boundary is not yet
# running locally. Point it at 8080 to exercise the full browser -> App -> RAG
# chain, or straight at 8081 to bypass the App service.
VITE_DEV_PROXY_TARGET=http://localhost:8081

# `1` selects the mock transport instead of the real /api/v1/ask client.
# Dev builds only; a production build drops the mock entirely.
# VITE_USE_MOCK_TRANSPORT=1
